{
  "name": "shopify/shopify-php",
  "description": "PHP library for the Shopify API",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Shopify\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Shopify\\Test\\": "test/"
    },
    "classmap": [
      "test/mock/",
      "test/Auth/Support.php"
    ]
  }
}
